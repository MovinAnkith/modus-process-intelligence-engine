# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modus_process_engine

# LLM Provider (Groq - free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Web search for evidence grounding (optional - free tier options: Tavily, SerpAPI)
# If left blank, the system falls back to LLM-only analysis with confidence
# marked as "insufficient_evidence" for transparency.
SEARCH_API_KEY=

# App
APP_ENV=development
